{
  "name": "hugagent-desktop-uos",
  "version": "0.5.23",
  "private": true,
  "type": "module",
  "main": "src/main.mjs",
  "description": "HugAgentOS Electron 43 desktop client for UOS 1070 aarch64",
  "homepage": "https://github.com/ZJU-REAL/HugAgentOS",
  "author": "HugAgentOS Team",
  "desktopName": "hugagent-uos.desktop",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron .",
    "build": "node scripts/build.mjs full",
    "build:thin": "node scripts/build.mjs thin",
    "pack:thin": "node scripts/build.mjs thin --dir",
    "test": "node --test test/*.test.mjs",
    "verify:deb": "node scripts/verify-deb.mjs",
    "release:manifest": "node scripts/merge-update-manifest.mjs",
    "lock:runtime": "node ../desktop/scripts/generate-platform-requirements-locks.mjs linux-aarch64"
  },
  "dependencies": {
    "extract-zip": "2.0.1",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hugagent.desktop",
    "productName": "HugAgentOS UOS",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src/frontend/dist",
        "to": "web"
      },
      {
        "from": "generated/server-ce.zip",
        "to": "server-ce.zip"
      },
      {
        "from": "generated/server-ce-manifest.json",
        "to": "server-ce-manifest.json"
      },
      {
        "from": "generated/runtime-core.tar.gz",
        "to": "runtime-core.tar.gz"
      },
      {
        "from": "generated/runtime-manifest.json",
        "to": "runtime-manifest.json"
      },
      {
        "from": "generated/bundle-flavor.json",
        "to": "bundle-flavor.json"
      },
      {
        "from": "generated/brand.json",
        "to": "brand.json"
      },
      {
        "from": "../desktop/src-tauri/icons/32x32.png",
        "to": "icon.png"
      }
    ],
    "protocols": [
      {
        "name": "HugAgentOS desktop authentication",
        "schemes": [
          "hugagent"
        ]
      }
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "Office",
      "executableName": "hugagent-uos",
      "executableArgs": [
        "--ozone-platform=x11"
      ],
      "maintainer": "HugAgentOS Team",
      "syncDesktopName": true,
      "icon": "../desktop/src-tauri/icons/icon.png",
      "artifactName": "${productName}_${version}_uos1070_${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "HugAgentOS",
          "Comment": "HugAgentOS desktop client for UOS 1070",
          "Categories": "Office;Network;",
          "StartupWMClass": "hugagent-uos",
          "Terminal": "false"
        }
      }
    },
    "deb": {
      "packageName": "hugagent-uos",
      "priority": "optional",
      "depends": [
        "libc6 (>= 2.28)",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libxkbcommon0",
        "libasound2",
        "xdg-utils"
      ],
      "recommends": [
        "libappindicator3-1 | libayatana-appindicator3-1"
      ]
    }
  }
}
