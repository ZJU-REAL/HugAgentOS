# Canonical versions of the CLI tools baked into the backend and sandbox images.
#
# Dockerfiles cannot read this file (the cube image is built from a flat context
# on a remote node), so each one keeps an `ARG NAME=value` default that must match.
# scripts/check_tool_versions.py (CI lint job, `make check-tool-versions`) fails
# when any Dockerfile or desktop pin drifts from these values. Change a version
# here and in every listed Dockerfile together.
#
# The backend writes per-user credentials for dws / lark-cli / himalaya and the
# sandboxes read them, so the backend and sandbox versions must stay identical.

# DingTalk Workspace CLI: docker/Dockerfile, sandbox/Dockerfile.opensandbox, sandbox/Dockerfile.cube-sandbox
DWS_VERSION=v1.0.39
# Feishu/Lark CLI: docker/Dockerfile, all three sandbox Dockerfiles
LARK_CLI_VERSION=1.0.78
# Email CLI: docker/Dockerfile, all three sandbox Dockerfiles
HIMALAYA_VERSION=1.2.0
# OfficeCLI: all three sandbox Dockerfiles
OFFICECLI_VERSION=v1.0.157
# Playwright (npm in the sandboxes, pip in desktop/requirements-desktop.txt)
PLAYWRIGHT_VERSION=1.59.0
