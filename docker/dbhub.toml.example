# [[sources]]
# id = "local_sqlite"
# description = "本地 SQLite"
# dsn = "sqlite:///app/data/local.db"
#
# [[tools]]
# name = "execute_sql"
# source = "local_sqlite"
# readonly = true
#
# [[tools]]
# name = "search_objects"
# source = "local_sqlite"
