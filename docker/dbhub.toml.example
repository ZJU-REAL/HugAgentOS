# DBHub 多库配置示例（现成开源 bytebase/dbhub）
#
# 推荐用法：在 Config 后台「数据库工具」面板增删改数据源，后端会自动把本格式渲染到
# docker/dbhub/dbhub.toml 并重启 DBHub 边车——无需手动编辑本文件。
#
# 手工用法（CE / 无后台）：
#   1. 复制本文件为 docker/dbhub/dbhub.toml，按需填写各 [[sources]]。
#   2. 用 `docker compose --profile dbhub up -d dbhub` 启动边车。
#
# 只读护栏写在 [[tools]] 里、不能写在 [[sources]] 里——DBHub 见到 [[sources]] 带 readonly
# 会直接拒绝启动。一旦出现任何 [[tools]] 块，DBHub 就只暴露声明过的工具，所以每个数据源都要
# 把 execute_sql 与 search_objects 两个工具都列出来；readonly 只对 execute_sql 有效。
#
# 安全建议：给每个数据库账号只读权限，并对每个 source 的 execute_sql 设 readonly=true。
# DSN 含密码，docker/dbhub/dbhub.toml 切勿提交进仓库（已在 .gitignore 忽略）。

# ── MySQL 示例 ───────────────────────────────────────────────────────────────
[[sources]]
id = "mysql_main"
description = "业务主库（MySQL）"
dsn = "mysql://readonly_user:password@mysql-host:3306/business_db"

[[tools]]
name = "execute_sql"
source = "mysql_main"
readonly = true

[[tools]]
name = "search_objects"
source = "mysql_main"

# ── PostgreSQL 示例 ──────────────────────────────────────────────────────────
[[sources]]
id = "pg_dw"
description = "数据仓库（PostgreSQL）"
dsn = "postgres://readonly_user:password@pg-host:5432/dw?sslmode=disable"
search_path = "public,analytics"

[[tools]]
name = "execute_sql"
source = "pg_dw"
readonly = true

[[tools]]
name = "search_objects"
source = "pg_dw"

# ── SQL Server 示例 ──────────────────────────────────────────────────────────
# [[sources]]
# id = "mssql_erp"
# description = "ERP 库（SQL Server）"
# dsn = "sqlserver://user:password@mssql-host:1433/erp"
#
# [[tools]]
# name = "execute_sql"
# source = "mssql_erp"
# readonly = true
#
# [[tools]]
# name = "search_objects"
# source = "mssql_erp"

