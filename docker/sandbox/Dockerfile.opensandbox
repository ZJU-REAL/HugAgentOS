# 自定义 OpenSandbox Code Interpreter 镜像
# 在 alibaba/OpenSandbox 官方镜像上叠加项目所需的 Python 包、系统命令、
# Node 工具与自建库，与原 script-runner sidecar 环境一致，做到 skill 脚本
# 切到 opensandbox 后零迁移风险。
#
# 构建：
#   docker build -t hugagent-opensandbox-custom:latest \
#     -f docker/sandbox/Dockerfile.opensandbox .
#
# 启用：在 .env 中设置
#   OPENSANDBOX_IMAGE=hugagent-opensandbox-custom:latest

# ─── 在 OpenSandbox 官方镜像上叠加依赖 ──────────────────────────────
FROM opensandbox/code-interpreter:v1.0.2
ARG TARGETARCH

# Jupyter / execd 都用 cpython-3.14.2，所有 pip 安装锁定到这个 venv。
# 基础镜像的 python 目录名含机器架构（x86_64 / aarch64），用符号链接抹平差异。
RUN ln -sfn /opt/python/versions/cpython-3.14.2-linux-*-gnu /opt/python/current \
    && /opt/python/current/bin/python3 --version
ENV PY_BIN=/opt/python/current/bin/python3 \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=8 \
    PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple \
    PIP_TRUSTED_HOST=repo.huaweicloud.com \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_PATH=/opt/node/v22.2.0/lib/node_modules

# ─── 系统依赖：字体 / 文档工具 ──────────────────────────────────────
# 镜像基于 Ubuntu 24.04 (noble)，sources 用 deb822 格式（ubuntu.sources）
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|https://mirrors.huaweicloud.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://mirrors.huaweicloud.com/ubuntu|g; s|http://ports.ubuntu.com/ubuntu-ports|https://mirrors.huaweicloud.com/ubuntu-ports|g' /etc/apt/sources.list.d/ubuntu.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
        fonts-wqy-zenhei fontconfig curl gnupg ca-certificates \
        pandoc zip unzip libreoffice-writer \
        qpdf \
        jq \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

# ─── Node.js 全局工具 + Playwright Chromium ─────────────────────────
# Node.js 22.2.0 已在镜像里
RUN mkdir -p /ms-playwright \
    && /opt/node/v22.2.0/bin/npm config set registry https://repo.huaweicloud.com/repository/npm/ \
    && /opt/node/v22.2.0/bin/npm install -g playwright@1.59.0 \
    && PLAYWRIGHT_BROWSERS_PATH=/ms-playwright /opt/node/v22.2.0/bin/npx playwright install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

# firecrawl CLI（网页抓取/检索）——firecrawl 插件的官方技能靠它运行（Bash(firecrawl *)）。
# 凭据不烤进镜像，由后端按需注入 FIRECRAWL_API_KEY / FIRECRAWL_API_URL 环境变量。
# 复用上面 npm config 设的华为云 registry；单独成层保留 playwright 大层缓存。
RUN /opt/node/v22.2.0/bin/npm install -g firecrawl-cli

# lark-cli（飞书/Lark 官方 CLI）——feishu-cli 插件的 lark-* 技能靠它运行（Bash(lark-cli *)）。
# 同时预装 whiteboard-cli：lark-whiteboard 技能运行时用 `npx @larksuite/whiteboard-cli@^0.2.11`，
# 预烤进镜像后离线/不可变沙箱可直接命中全局缓存、无需联网重拉。
# 复用上面华为云 registry；应用配置与用户登录凭据都不烤进镜像（后端 config init 写入 +
# auth login 设备流落盘后 bind-mount 进沙盒），均跨会话持久化。
# ⚠️ 版本必须与后端镜像 docker/Dockerfile 的 LARK_CLI_VERSION 保持一致：两侧共用同一份
# 凭据文件（后端写 config/token，沙箱读），且后端解析 `auth status` 的输出。此前这里不锁
# 版本、浮动到 latest，与后端固定的旧版拉开了几十个小版本，是一类静默故障源。
RUN /opt/node/v22.2.0/bin/npm install -g @larksuite/cli@1.0.78 @larksuite/whiteboard-cli@^0.2.11

# openyida（宜搭低代码平台官方 CLI）——yida 插件技能靠它运行（Bash(openyida *)）。
# 登录态不烤进镜像：cookie 落在工作目录 .cache/ 下，由后端 per-user 持久卷把
# ~/yida-workspace 挂进沙箱，对话内扫码登录（openyida login --agent-qr）后跨会话存活。
# 复用上面华为云 registry；版本与 yida 插件技能包（同步自 openyida-skills.zip
# v2026.7.12-1）对齐，升级技能包时同步升级此处版本。
RUN /opt/node/v22.2.0/bin/npm install -g openyida@2026.7.12-1

# ─── Python 数据/文档/网络全家桶 ───────────────────────────────────
COPY docker/sandbox/requirements-script-runner.txt /tmp/req-script-runner.txt
# Interactive package workers use FastAPI/uvicorn inside the sandbox.
RUN $PY_BIN -m pip install --no-cache-dir -r /tmp/req-script-runner.txt \
    && rm /tmp/req-script-runner.txt

# Skill 依赖（由 backend admin UI 触发 rebuild 前聚合写入 requirements-skills.txt）。
# 依赖**只**在此 bake 进镜像；沙盒启动不再跑 pip。新增依赖须重新构建本镜像
# （管理台 → 沙盒依赖 → 重建）。/opt/skill-deps/ 副本仅留作排查参考。
COPY docker/sandbox/requirements-skills.txt /opt/skill-deps/requirements-skills.txt
RUN $PY_BIN -m pip install --no-cache-dir -r /opt/skill-deps/requirements-skills.txt || \
    (echo "[opensandbox] skill-deps install failed; continuing with empty set"; true)

# ─── docx 预编译 CLI（来自 stage 1） ────────────────────────────────
# pdf-editing 在 scripts/engine/ 内置引擎包，无共享 office 库可装；引擎随技能
# 文件在运行时物化进 /workspace。Word / Excel / PPT 走下面预装的 officecli。

# 健康检查：能 import 关键包就算 OK（构建时执行，build 失败立即暴露）
RUN $PY_BIN -c "import pandas, numpy, matplotlib, openpyxl, docx, pptx, PIL, pdfplumber, reportlab, pikepdf, markitdown, requests, lxml, tabulate, tqdm; print('all script-runner deps OK')"

# ─── LibreOffice 转 PDF 完整支持 ────────────────────────────────────
# 上方只装了 libreoffice-writer (.docx → .pdf 不需要 Java)。.xlsx / .pptx
# 转 PDF 需要：
#   - libreoffice-calc / libreoffice-impress：对应文件类型转换器
#   - libreoffice-java-common：提供 javaldx 让 LO 把已有 JRE 接进 UNO；
#     否则 LO 报 "failed to launch javaldx" + "source file could not be loaded"
# 基础镜像已自带 OpenJDK 21，不必再装 default-jre
RUN apt-get update && apt-get install -y --no-install-recommends \
        libreoffice-calc libreoffice-impress libreoffice-java-common \
    && rm -rf /var/lib/apt/lists/* \
    # unopkg sync 注册 JRE 到 LibreOffice，构建时一次完成，沙盒首次转换无延迟
    && unopkg sync || true

# ─── pdf-cli 全局 shim（pdf-editing skill 的对应） ───────────────────
# 让智能体在 bash 里直接 `pdf-cli read …` / `pdf-cli create …` 等。shim
# 运行时解析 /workspace/skills/pdf-editing/scripts/cli.py。
COPY src/backend/extensions/skills/default/pdf-editing/scripts/pdf-cli /usr/local/bin/pdf-cli
RUN chmod +x /usr/local/bin/pdf-cli
ENV PDF_SKILL_DIR=/workspace/skills/pdf-editing

# ─── dws（DingTalk Workspace CLI）─────────────────────────────────────
# 钉钉全产品 CLI（dingtalk marketplace 技能的对应二进制），单 Go 文件无运行时
# 依赖。版本随镜像固定，禁止容器内自升级（沙箱不可变，升级走重建镜像）。
# 凭据不在镜像里：由后端 per-user 持久卷把 ~/.dws + ~/.local/share/dws-cli
# 挂进沙箱，token 由 dws 自动刷新并回写。
ARG DWS_VERSION=v1.0.39
RUN curl -fsSL --retry 2 --retry-delay 2 --retry-all-errors --connect-timeout 15 --max-time 60 \
        "https://gh-proxy.com/https://github.com/DingTalk-Real-AI/dingtalk-workspace-cli/releases/download/${DWS_VERSION}/dws-linux-${TARGETARCH:-amd64}.tar.gz" \
        -o /tmp/dws.tar.gz \
    && tar -xzf /tmp/dws.tar.gz -C /usr/local/bin dws \
    && chmod +x /usr/local/bin/dws \
    && rm -f /tmp/dws.tar.gz \
    && dws --version

# ─── himalaya（电子邮箱 CLI）────────────────────────────────────────────
# email 插件的 email 技能靠它运行（Bash(himalaya *)）：IMAP/SMTP 收发与管理邮件。
# 静态二进制（musl，static-pie），无运行时依赖；tarball 里 himalaya 在根。凭据不在
# 镜像里：由后端 per-user 持久卷把 ~/.config/himalaya 挂进沙箱（含 config.toml）。
ARG HIMALAYA_VERSION=1.2.0
RUN HIMALAYA_ARCH="$([ "${TARGETARCH:-amd64}" = "arm64" ] && echo aarch64 || echo x86_64)" \
    && curl -fsSL --retry 2 --retry-delay 2 --retry-all-errors --connect-timeout 15 --max-time 60 \
        "https://gh-proxy.com/https://github.com/pimalaya/himalaya/releases/download/v${HIMALAYA_VERSION}/himalaya.${HIMALAYA_ARCH}-linux.tgz" \
        -o /tmp/himalaya.tgz \
    && tar -xzf /tmp/himalaya.tgz -C /usr/local/bin himalaya \
    && chmod +x /usr/local/bin/himalaya \
    && rm -f /tmp/himalaya.tgz \
    && himalaya --version

# ─── 对话建站 React+Vite 模板（源码 + 预装 node_modules + init 脚本）────
# sites 插件 site-builder 技能的 React 工程路径靠它：init 脚本把模板铺进项目
# 目录、node_modules 硬链接物化到 /workspace 临时区（秒级、离线、不进 myspace）。
# 构建期跑一次 smoke build：模板坏了在镜像构建阶段立刻暴露，而不是用户对话里。
# manifest 单独成层先 npm ci：模板源码微调不再击穿依赖层缓存（lock 不变即命中）
COPY docker/sandbox/site-template/react-vite/package.json \
     docker/sandbox/site-template/react-vite/package-lock.json \
     docker/sandbox/site-template/react-vite/.npmrc \
     /opt/site-template/react-vite/
RUN cd /opt/site-template/react-vite \
    && export PATH=/opt/node/v22.2.0/bin:$PATH \
    && npm ci --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /root/.npm
COPY docker/sandbox/site-template/init-react-site.sh /opt/site-template/init-react-site.sh
COPY docker/sandbox/site-template/react-vite/ /opt/site-template/react-vite/
RUN cd /opt/site-template/react-vite \
    && export PATH=/opt/node/v22.2.0/bin:$PATH \
    && SITE_DIST=/tmp/site-smoke SITE_CACHE=/tmp/site-cache npm run build \
    && test -f /tmp/site-smoke/index.html \
    && rm -rf /tmp/site-smoke /tmp/site-cache \
    && chmod +x /opt/site-template/init-react-site.sh \
    && chown -R 1000:1000 /opt/site-template

# ─── officecli（OfficeCLI 二进制）──────────────────────────────────────
# 内置的 officecli-* / morph-ppt* 十个技能靠它运行（Bash(officecli *)）。单文件
# 原生二进制，内嵌 .NET runtime，不依赖 Office 或 LibreOffice。版本随镜像固定，
# 禁止容器内自升级——技能文档里已把上游的「curl 联网安装」改成「沙盒已预装」，
# 沙箱本身也不保证有外网。走 gh-proxy 与同文件的 dws / himalaya 保持一致。
ARG OFFICECLI_VERSION=v1.0.157
RUN OFFICECLI_ARCH="$([ "${TARGETARCH:-amd64}" = "arm64" ] && echo arm64 || echo x64)" \
    && curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors --connect-timeout 20 --max-time 300 \
        "https://gh-proxy.com/https://github.com/iOfficeAI/OfficeCLI/releases/download/${OFFICECLI_VERSION}/officecli-linux-${OFFICECLI_ARCH}" \
        -o /usr/local/bin/officecli \
    && chmod +x /usr/local/bin/officecli \
    && officecli --version

# officecli 的 `view <file> screenshot` 靠 chrome 系无头浏览器渲染，探测的是 PATH
# 上的 google-chrome / chromium / msedge。Playwright 把 Chromium 装在 /ms-playwright
# 下、不在 PATH 上，所以软链一个 `chromium` 出来，否则技能里的视觉质检门只能退化
# 成 view html。
RUN CHROME_BIN="$(find /ms-playwright -maxdepth 4 -type f -name chrome -path '*chrome-linux*' 2>/dev/null | head -n1)" \
    && if [ -n "$CHROME_BIN" ]; then \
         ln -sf "$CHROME_BIN" /usr/local/bin/chromium; \
         echo "[opensandbox] officecli screenshot → $CHROME_BIN"; \
       else \
         echo "[opensandbox] no Chromium found; officecli screenshot will fall back to view html" >&2; \
       fi

# ─── 用户代码以 ubuntu (UID 1000) 执行，配合 myspace bind mount ──────────────
# 沙盒里跑用户代码的身份是 ubuntu（execd RunCommandOpts uid/gid=1000），与 backend
# 容器的 appuser 同为 UID 1000。这样 bind 进来的 /workspace/myspace/{uid} 两边同属主，
# 沙盒写的文件 host 上 backend 能覆盖/删除。
#
# ⚠️ /workspace/myspace **必须在镜像里预先建好**：docker 在 bind mount 时会自动补建
# 缺失的父目录，挂载点属主会被它定死。预建之后 docker 直接往现成目录上挂。
#
# ⚠️ 父目录本身**必须保持 root 属主**：可写的「我的空间」只有它下面的 bind mount
# /workspace/myspace/{uid}，父目录不在任何同步范围内（对账只扫 {uid} 子树，产物清单
# 整个跳过 myspace）。它一旦可写，`cp x /workspace/myspace/` 就退出码 0、看似成功而
# 文件永远进不了「我的空间」且毫无报错；保持只读才能让误写立刻 Permission denied。
#
# 注：execd 自身仍以 root 跑，_persistent_setup 里的 `ln -s ... /myspace` 要写 / ，
# 那一步必须是 root；历史上试图用 setpriv wrapper 把整个沙盒切到 ubuntu 的做法与此
# 冲突（且 entrypoint 被 provider 覆盖后根本执行不到），已删除。
RUN mkdir -p /home/ubuntu/.local /home/ubuntu/.jupyter /home/ubuntu/.npm \
             /home/ubuntu/.cache /home/ubuntu/.config \
             /workspace/scratch /workspace/myspace \
    && chown -R 1000:1000 /home/ubuntu /workspace \
    # 见上：myspace 挂载点的父目录归还 root，用户代码不得直接往里写
    && chown 0:0 /workspace/myspace \
    # /opt/node 全局模块目录让 ubuntu 可写（tslab install 走这里）。read-only 锁
    # 的是 /opt/node 本身和已装包，rw 给 ubuntu 是新增包写。
    && chown -R 1000:1000 /opt/node/v22.2.0/lib/node_modules /opt/node/v22.2.0/bin 2>/dev/null || true \
    # python kernel 安装目标（启动期 ipykernel install --name python 写这里）
    && chown -R 1000:1000 /opt/python/versions/*/share/jupyter 2>/dev/null || true \
    # 预装 'python' 内核名（execd 启动期 POST /code/context 找的是这个 name）。
    # base image 已自带 'python3' 内核但 name 不对应；以 root 系统级安装一次 'python'
    # 名，避免运行时 setup_python 在 ubuntu 下 ipykernel install 失败导致没有 python kernel。
    # 给每个 python 版本各装一份，覆盖 entrypoint 切版本场景。
    && for PYDIR in /opt/python/versions/cpython-*; do \
           "$PYDIR/bin/python3" -m ipykernel install --name python --display-name "Python" 2>/dev/null || true; \
       done

# Real launch detects driver/browser revision mismatches before delivery.
COPY docker/sandbox/verify-browser-runtime.py /opt/verify-browser-runtime.py
RUN runuser -u ubuntu -- $PY_BIN /opt/verify-browser-runtime.py --container-isolated

# ─── sandbox-init（PID 1 + 命令的 subreaper）─────────────────────────────
# 由 provider 的 entrypoint 作为 PID 1 启动：回收所有孤儿进程，并杀掉沙盒用户
# （SANDBOX_RUN_UID）在命令结束后留下的进程；每条用户命令经 `sandbox-init
# --subreaper` 运行，setsid / 两次 fork 也逃不出命令的进程树。放在末尾，
# 改动不击穿上面的大层缓存。
COPY docker/sandbox/sandbox-init.c /tmp/sandbox-init.c
RUN gcc -O2 -Wall -Werror -o /usr/local/bin/sandbox-init /tmp/sandbox-init.c \
    && rm /tmp/sandbox-init.c
