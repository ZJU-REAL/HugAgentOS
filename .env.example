# =============================================================================
# HugAgentOS 社区版环境配置示例
# 复制为 .env 后按需修改。单机最小可用配置开箱即用。
# =============================================================================

# ── 版本 ─────────────────────────────────────────────────────────────────────
JX_EDITION=ce
COMPOSE_PROJECT_NAME=hugagent

# ── 品牌（可自定义；协议要求保留 Powered-by 标识） ───────────────────────────
BRAND_PRODUCT_NAME=HugAgentOS
BRAND_ORG_NAME=

# ── 数据库（compose 内置 postgres；本地开发可用 sqlite） ─────────────────────
DATABASE_URL=postgresql+psycopg2://hugagent:hugagent@postgres:5432/hugagent
POSTGRES_USER=hugagent
POSTGRES_PASSWORD=hugagent
POSTGRES_DB=hugagent

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── 认证（社区版默认本地账号登录；首次启动创建 admin/admin 并强制改密） ──────
AUTH_MODE=session
SSO_LOGIN_MODE=local

# ── Web 构建默认值（CE 首屏即按社区版和英文渲染，避免等待接口时闪现 EE 内容） ──
VITE_EDITION=ce
VITE_DEFAULT_LANGUAGE=en

# ── LLM（模型接入） ──────────────────────────────────────────────────────────
# 模型配置存数据库（不走 env）：启动后在 Web「设置 → 系统管理 → 模型服务」
# 填 OpenAI 兼容端点（base_url / api_key / 模型名），或本地单机模式跑
# `hugagent-server onboard` 交互引导。

# ── 互联网搜索（可选；也可在「设置 → 系统管理 → 服务配置」里配，DB 优先） ──
# INTERNET_SEARCH_ENGINE=tavily        # tavily / baidu / langsearch / deepseek
# TAVILY_API_KEY=
# BAIDU_API_KEY=
# LANGSEARCH_API_KEY=
# DEEPSEEK_SEARCH_API_KEY=

# ── 存储（社区版：本地文件） ─────────────────────────────────────────────────
STORAGE_TYPE=s3
COMPOSE_FILE=docker-compose.yml:docker/object-storage/compose.object-storage.yml
S3_ENDPOINT=http://object-storage:9000
S3_BUCKET=hugagent-files
S3_REGION=us-east-1
# Generated by configure-ce-docker.py; never use shared default credentials.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# 宿主机存储目录的绝对路径（compose 挂载用）
# Run python3 scripts/configure-ce-docker.py to fill these absolute paths.
HOST_REPO_PATH=
HOST_STORAGE_PATH=

# ── Docker sandbox: OpenSandbox ────────────────────────────────────────────
SANDBOX_PROVIDER=opensandbox
COMPOSE_PROFILES=opensandbox
SANDBOX_TOOLS_ENABLED=true
OPENSANDBOX_DOMAIN=http://opensandbox:8080
# Generated by configure-ce-docker.py; must match the controller configuration.
OPENSANDBOX_API_KEY=
OPENSANDBOX_IMAGE=hugagent-opensandbox-custom:latest
SANDBOX_IDLE_TTL_S=3600
SANDBOX_ARTIFACT_MAX_BYTES=104857600
OPENSANDBOX_SNAPSHOT_ENABLED=true
OPENSANDBOX_SNAPSHOT_RETENTION_DAYS=7
OPENSANDBOX_POOL_JUPYTER_MIN_IDLE=0
OPENSANDBOX_POOL_LIGHT_MIN_IDLE=0
OPENSANDBOX_POOL_MAX_TOTAL=4
# Explicit lightweight alternative: set SANDBOX_PROVIDER and COMPOSE_PROFILES
# both to script_runner and set SANDBOX_RUNNER_URL=http://script-runner:8900.

# ── 记忆（L1 画像默认开箱；L2/L3 需启用 compose 的 mem0 profile） ────────────
MEM0_ENABLED=false
# MEM0_GRAPH_ENABLED=false

# ── 服务端口 ─────────────────────────────────────────────────────────────────
# BACKEND_PORT 是容器内部端口；只想修改宿主机公开端口时改 BACKEND_HOST_PORT。
BACKEND_PORT=3001
BACKEND_HOST_PORT=3001
FRONTEND_PORT=3002
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6380

# Personal Agent (CE/EE): optional module, off unless enabled here.
# CE allows authenticated users; EE also applies account/role/team permission.
# No Personal Agent license feature is required. Start the dedicated
# controller with docker/personal-agent/compose.personal-agent.yml and --profile personal-agent.
PERSONAL_AGENT_ENABLED=false
# Build a versioned graphical image before use.
# docker build -f docker/personal-agent/Dockerfile.personal-agent -t hugagent-personal-agent:v5 .
# Do not overwrite a tag used by a running permanent computer.
PERSONAL_AGENT_IMAGE=hugagent-personal-agent:v5
# Backend API reachable from the permanent computer. No credential value here.
# When the sandbox runs on another server, use e.g. http://<app private address>/api
PERSONAL_AGENT_CLI_SERVER=http://backend:3001
# Plain HTTP is allowed for private deployments without TLS; false requires HTTPS.
PERSONAL_AGENT_CLI_ALLOW_HTTP=true
# Compose maps HOST_STORAGE_PATH/personal-agent to /app/storage/personal-agent.
# For custom deployments these two roots must point to the same dedicated data.
# PERSONAL_AGENT_VOLUME_ROOT=/absolute/host/storage/personal-agent
# PERSONAL_AGENT_LOCAL_VOLUME_ROOT=/app/storage/personal-agent

# Personal Agent uses a dedicated authenticated compute controller.
PERSONAL_AGENT_OPENSANDBOX_DOMAIN=personal-agent-opensandbox:8080
PERSONAL_AGENT_OPENSANDBOX_API_KEY=

# Heartbeat: the agent checks the user's HEARTBEAT.md at an interval and stays quiet
# unless something needs the user. Users turn it on in Personal Agent settings.
# off stops all checks on this backend; the settings stay.
# PERSONAL_AGENT_HEARTBEAT=on
# PERSONAL_AGENT_HEARTBEAT_MIN_MINUTES=15
# PERSONAL_AGENT_HEARTBEAT_DAILY_MAX=48

# End Personal Agent settings
