{
  "name": "hugagent-customer-chat-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build-component.mjs && tsc --emitDeclarationOnly",
    "standalone": "vite build --base /customer/ --outDir standalone-dist",
    "dev": "vite --open /preview.html",
    "dev:headless": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "prepack": "npm run build",
    "test": "node scripts/test-proxy.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "@types/react-dom": "^19.2.0",
    "@hugagent/chat-sdk": "file:../../packages/chat-sdk"
  },
  "exports": {
    ".": {
      "types": "./dist/customization.d.ts",
      "import": "./dist/customization.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@hugagent/chat-sdk": "^1.0.0"
  }
}
