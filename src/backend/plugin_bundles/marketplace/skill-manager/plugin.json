{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "skill-manager",
  "version": "2.0.0",
  "description": "在对话里用自然语言管理技能：搜索并安装技能市场里的技能、用打包的 skill-creator 技能从零创建你自己的私有技能、编辑修改已有私有技能的内容、把私有技能申请上架到技能市场、查看/删除你的技能，也支持给一个 web 链接从中下载并安装技能或插件。装上后智能体即可原生地创建、编辑、管理、删除、申请上架技能。",
  "author": {
    "name": "HugAgentOS"
  },
  "extensions": {
    "org.hugagent": {
      "mcp": {
        "skill_manager": {
          "display_name": "技能管理",
          "description": "管理当前执行环境的私有技能。本机安装读取目录或压缩包；云端安装读取当前账号的产物。上传云端和申请市场发布分别执行。",
          "tools": [
            {
              "name": "search_marketplace",
              "description": "搜索技能市场，返回匹配的可安装技能列表（slug/名称/简介/分类/是否已安装）。\n\n    用户想\"看看有没有现成的 X 技能 / 技能市场里有什么 / 找一个能做 Y 的技能\"时调用。\n    - query：关键词（在名称/简介/标签/分类里模糊匹配；留空=列全部）。\n    - category：按分类过滤（可选）。\n    找到目标后用 install_from_marketplace(slug) 安装。\n    ",
              "inputSchema": {
                "properties": {
                  "query": {
                    "default": "",
                    "title": "Query",
                    "type": "string"
                  },
                  "category": {
                    "default": "",
                    "title": "Category",
                    "type": "string"
                  }
                },
                "title": "search_marketplaceArguments",
                "type": "object"
              },
              "outputSchema": {
                "properties": {
                  "result": {
                    "additionalProperties": true,
                    "title": "Result",
                    "type": "object"
                  }
                },
                "required": [
                  "result"
                ],
                "title": "search_marketplaceOutput",
                "type": "object"
              }
            },
            {
              "name": "install_from_marketplace",
              "description": "从技能市场安装一个技能到\"我的私有技能库\"，装完即可在对话中使用。\n\n    用户说\"装上那个技能 / 安装 X 技能 / 把它加到我的能力里\"时调用。slug 取自 search_marketplace。\n    若该技能需要 API Key 等凭据（返回报错提示缺凭据），先向用户要，再重试。\n    - secrets：按市场技能 required_secrets 的 key 传入凭据，例如 {\"IMAGE_GEN_API_KEY\":\"...\"}。\n    【铁律】未成功拿到 ✅ 前不要声称已安装。需要管理员开启\"自助添加技能\"权限。\n    ",
              "inputSchema": {
                "properties": {
                  "slug": {
                    "title": "Slug",
                    "type": "string"
                  },
                  "secrets": {
                    "anyOf": [
                      {
                        "additionalProperties": {
                          "type": "string"
                        },
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Secrets"
                  }
                },
                "required": [
                  "slug"
                ],
                "title": "install_from_marketplaceArguments",
                "type": "object"
              },
              "outputSchema": {
                "properties": {
                  "result": {
                    "additionalProperties": true,
                    "title": "Result",
                    "type": "object"
                  }
                },
                "required": [
                  "result"
                ],
                "title": "install_from_marketplaceOutput",
                "type": "object"
              }
            },
            {
              "name": "submit_to_marketplace",
              "description": "把我的私有技能申请上架到技能市场（进管理员审核队列，通过后其他人可安装）。\n\n    用户说\"把我的技能分享出去 / 申请上架 / 发布到市场\"时调用。skill_id 取自云端 list_skills 的 install_id。\n    - category：市场分类，**必须**从这 8 个固定值里挑最贴切的一个：\n      写作助手 / 文档处理 / 数据分析 / 政策产业 / 营销创意 / 法务合规 / 办公效率 / 研发效率。\n    - summary：一句话简介（可选）。\n    - note：给审核管理员的说明（可选）。\n    【说明】这是\"申请\"，不是直接上架；需管理员审核通过。需要\"自助添加技能\"权限。\n    ",
              "inputSchema": {
                "properties": {
                  "skill_id": {
                    "title": "Skill Id",
                    "type": "string"
                  },
                  "category": {
                    "default": "",
                    "title": "Category",
                    "type": "string"
                  },
                  "summary": {
                    "default": "",
                    "title": "Summary",
                    "type": "string"
                  },
                  "note": {
                    "default": "",
                    "title": "Note",
                    "type": "string"
                  }
                },
                "required": [
                  "skill_id"
                ],
                "title": "submit_to_marketplaceArguments",
                "type": "object"
              },
              "outputSchema": {
                "properties": {
                  "result": {
                    "additionalProperties": true,
                    "title": "Result",
                    "type": "object"
                  }
                },
                "required": [
                  "result"
                ],
                "title": "submit_to_marketplaceOutput",
                "type": "object"
              }
            },
            {
              "name": "install_skill",
              "description": "安装技能到当前用户的云端私有库。接收当前云端包产物 ID，不接收本机路径。同名内容不同时返回冲突，请显式更新。成功后返回安装 ID、版本及可用状态。",
              "inputSchema": {
                "$defs": {
                  "ArtifactSource": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "artifact",
                        "title": "Kind",
                        "type": "string"
                      },
                      "artifact_id": {
                        "title": "Artifact Id",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "artifact_id"
                    ],
                    "title": "ArtifactSource",
                    "type": "object"
                  }
                },
                "properties": {
                  "source": {
                    "$ref": "#/$defs/ArtifactSource"
                  }
                },
                "required": [
                  "source"
                ],
                "title": "installArguments",
                "type": "object"
              },
              "annotations": {
                "readOnlyHint": false
              },
              "_meta": {
                "org.hugagent/executor": {
                  "id": "skill-manager",
                  "version": 1
                }
              }
            },
            {
              "name": "list_skills",
              "description": "列出当前用户云端已安装的技能，返回精确安装 ID 和 revision。",
              "inputSchema": {
                "properties": {},
                "title": "list_installedArguments",
                "type": "object"
              },
              "annotations": {
                "readOnlyHint": true
              },
              "_meta": {
                "org.hugagent/executor": {
                  "id": "skill-manager",
                  "version": 1
                }
              }
            },
            {
              "name": "get_skill",
              "description": "读取一个已安装技能的版本、内容位置与组件信息。",
              "inputSchema": {
                "properties": {
                  "install_id": {
                    "title": "Install Id",
                    "type": "string"
                  }
                },
                "required": [
                  "install_id"
                ],
                "title": "getArguments",
                "type": "object"
              },
              "annotations": {
                "readOnlyHint": true
              },
              "_meta": {
                "org.hugagent/executor": {
                  "id": "skill-manager",
                  "version": 1
                }
              }
            },
            {
              "name": "update_skill",
              "description": "用完整包更新已有技能，先读取当前 revision。版本变化则拒绝覆盖。插件及子组件一起更新；插件内技能必须通过插件管理。",
              "inputSchema": {
                "$defs": {
                  "ArtifactSource": {
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "artifact",
                        "title": "Kind",
                        "type": "string"
                      },
                      "artifact_id": {
                        "title": "Artifact Id",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "artifact_id"
                    ],
                    "title": "ArtifactSource",
                    "type": "object"
                  }
                },
                "properties": {
                  "install_id": {
                    "title": "Install Id",
                    "type": "string"
                  },
                  "source": {
                    "$ref": "#/$defs/ArtifactSource"
                  },
                  "expected_revision": {
                    "title": "Expected Revision",
                    "type": "string"
                  }
                },
                "required": [
                  "install_id",
                  "source",
                  "expected_revision"
                ],
                "title": "updateArguments",
                "type": "object"
              },
              "annotations": {
                "readOnlyHint": false
              },
              "_meta": {
                "org.hugagent/executor": {
                  "id": "skill-manager",
                  "version": 1
                }
              }
            },
            {
              "name": "uninstall_skill",
              "description": "撤销当前用户的技能安装登记。插件及子组件一起卸载，保留导入源文件和历史版本，不删除云端副本。",
              "inputSchema": {
                "properties": {
                  "install_id": {
                    "title": "Install Id",
                    "type": "string"
                  },
                  "expected_revision": {
                    "title": "Expected Revision",
                    "type": "string"
                  }
                },
                "required": [
                  "install_id",
                  "expected_revision"
                ],
                "title": "uninstallArguments",
                "type": "object"
              },
              "annotations": {
                "readOnlyHint": false
              },
              "_meta": {
                "org.hugagent/executor": {
                  "id": "skill-manager",
                  "version": 1
                }
              }
            }
          ]
        }
      },
      "local_execution": {
        "id": "skill-manager",
        "version": 1
      }
    }
  }
}
