{
  "name": "@hugagent/workbench-protocol",
  "version": "1.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
